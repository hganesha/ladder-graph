{
  "name": "ladder-graph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run catalog:generate && tsc -b && vite build",
    "catalog:generate": "node scripts/generate-catalog-index.mjs && biome format --write src/generated/catalog.ts",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "wasm:build": "wasm-pack build crates/lgir-wasm --target web --out-dir ../../src/wasm/pkg --release && node scripts/normalize-wasm-artifacts.mjs",
    "rust:test": "cargo test --workspace",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@dagrejs/dagre": "^3.0.4",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/outfit": "^5.2.6",
    "@fontsource/syne": "^5.2.6",
    "@uiw/react-codemirror": "^4.25.1",
    "@xyflow/react": "^12.8.5",
    "dexie": "^4.0.11",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@playwright/test": "^1.55.0",
    "@types/dagre": "^0.7.52",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
