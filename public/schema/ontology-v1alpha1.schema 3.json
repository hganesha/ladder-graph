{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ladder.dev/schema/ontology-v1alpha1.schema.json",
  "title": "Ladder Graph Ontology v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "ladder.dev/v1alpha1" },
    "kind": { "const": "Ontology" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["types", "relationships"],
      "properties": {
        "types": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/type" } },
        "relationships": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/relationship" } }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["system"],
          "properties": {
            "system": { "type": "string" },
            "sourceId": { "type": "string" },
            "sourcePath": { "type": "string" },
            "sourceVersion": { "type": "string" },
            "sourceDigest": { "type": "string" }
          }
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "dataType"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "dataType": { "enum": ["string", "integer", "number", "decimal", "boolean", "date", "datetime", "array", "object"] },
        "required": { "type": "boolean" },
        "identifier": { "type": "boolean" },
        "allowedValues": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
        "unit": { "type": "string" },
        "sourcePath": { "type": "string" }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "properties"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "parentTypeIds": { "type": "array", "items": { "type": "string" } },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
        "sourcePath": { "type": "string" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "sourceTypeId", "targetTypeId", "cardinality"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "sourceTypeId": { "type": "string" },
        "targetTypeId": { "type": "string" },
        "cardinality": { "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"] },
        "inverseRelationshipId": { "type": "string" },
        "required": { "type": "boolean" },
        "sourcePath": { "type": "string" }
      }
    }
  }
}
