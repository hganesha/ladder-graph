{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ladder.dev/schema/catalog-snapshot-v2.schema.json",
  "title": "Ladder Graph local catalog snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "installationId", "publishedAt", "revision", "entries"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "installationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "revision": { "type": "string", "maxLength": 80 },
    "entries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "scope", "title", "content"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 128 },
          "kind": { "enum": ["workflow", "agent-template", "ontology", "form", "document", "workflow-bundle"] },
          "scope": { "const": "user" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 1000 },
          "version": { "type": "string", "maxLength": 64 },
          "tags": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 100 } },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" },
          "sourceHash": { "type": "string", "maxLength": 80 },
          "mediaType": { "const": "application/yaml" },
          "content": { "type": "string", "maxLength": 2000000 }
        }
      }
    }
  }
}
