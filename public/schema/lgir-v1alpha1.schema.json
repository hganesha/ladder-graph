{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ladder.dev/schema/lgir-v1alpha1.schema.json",
  "title": "Ladder Graph Intermediate Representation",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "ladder.dev/v1alpha1" },
    "kind": { "const": "Workflow" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["objective", "nodes", "edges"],
      "properties": {
        "objective": { "type": "string" },
        "inputs": { "type": "object" },
        "outputs": { "type": "object" },
        "policies": { "type": "object" },
        "nodes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["id", "kind", "name"],
            "properties": {
              "id": { "type": "string" },
              "kind": {
                "enum": [
                  "input",
                  "output",
                  "agent",
                  "tool",
                  "transform",
                  "condition",
                  "evaluate",
                  "teacher",
                  "approval",
                  "join",
                  "aggregator",
                  "loop",
                  "group",
                  "subgraph"
                ]
              },
              "name": { "type": "string" },
              "summary": { "type": "string" },
              "role": { "type": "string" },
              "prompt": { "type": "string" },
              "inputSchema": { "type": ["object", "null"] },
              "outputSchema": { "type": ["object", "null"] },
              "capabilities": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "connectors": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "customizations": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": ["template", "instructions"],
                      "additionalProperties": false,
                      "properties": {
                        "template": { "type": "string", "minLength": 1 },
                        "instructions": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "config": {
                "type": "object",
                "properties": {
                  "operation": { "enum": ["select", "rename", "merge", "filter", "deduplicate", "sort", "slice", ""] },
                  "expression": { "type": "string" },
                  "branches": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["label", "when"],
                      "additionalProperties": false,
                      "properties": {
                        "label": { "type": "string", "minLength": 1 },
                        "when": { "type": "string", "minLength": 1 }
                      }
                    }
                  },
                  "join": { "enum": ["all", "allSettled", "first", ""] },
                  "aggregation": { "enum": ["collect", "merge", "concat", "vote", ""] },
                  "teacherModel": { "type": "string" },
                  "feedbackMode": { "enum": ["critique", "score", "rubric", ""] },
                  "workingDirectory": { "type": "string" },
                  "body": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "exitCondition": { "type": "string" },
                  "maxIterations": { "type": "integer", "minimum": 0, "maximum": 100 },
                  "onExhausted": { "enum": ["stop", "continue", "warn", ""] },
                  "carry": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
                    "additionalProperties": { "type": "string", "pattern": "^/" }
                  },
                  "threshold": { "type": "number" },
                  "members": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "execution": { "enum": ["sequential", "parallel", ""] },
                  "exit": { "enum": ["aggregate", "serialize", ""] },
                  "router": { "type": "string", "minLength": 1 },
                  "defaultBranch": { "type": "string", "minLength": 1 },
                  "entry": { "type": "string", "minLength": 1 },
                  "exitNode": { "type": "string", "minLength": 1 },
                  "subgraph": {
                    "type": "object",
                    "required": ["ref", "inputMap", "outputMap"],
                    "additionalProperties": false,
                    "properties": {
                      "ref": { "type": "string", "pattern": "^(ladder://|host:).+" },
                      "inputMap": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": { "type": "string", "pattern": "^/" }
                      },
                      "outputMap": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": { "type": "string", "pattern": "^/" }
                      },
                      "checkpointer": { "enum": ["inherit", "perInvocation", "perThread", "stateless"] }
                    }
                  }
                }
              },
              "position": { "type": "object" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "from", "to", "kind"],
            "properties": {
              "id": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "kind": { "enum": ["data", "dependency", "control"] },
              "contract": { "type": "string" },
              "condition": { "type": "string" },
              "sourcePath": { "type": "string", "pattern": "^/" },
              "targetPath": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    }
  }
}
