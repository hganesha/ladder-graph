{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ladder.dev/schema/document-v1alpha1.schema.json",
  "title": "Ladder Graph Document v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "ladder.dev/v1alpha1" },
    "kind": { "const": "Document" },
    "metadata": { "$ref": "ontology-v1alpha1.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentType", "sections", "fields"],
      "properties": {
        "documentType": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "fieldIds"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "fieldIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "label", "dataType"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
              "label": { "type": "string" },
              "description": { "type": "string" },
              "dataType": { "enum": ["string", "integer", "number", "boolean", "date", "datetime", "array", "object"] },
              "required": { "type": "boolean" },
              "ontologyPropertyRef": { "type": "string" },
              "sourcePath": { "type": "string" }
            }
          }
        },
        "validationRules": { "type": "array", "items": { "type": "object" } },
        "reviewPolicy": { "type": "object" },
        "modelRouting": { "type": "object" },
        "outputSchema": { "type": "object" },
        "inertSourceMetadata": { "type": "object" }
      }
    }
  }
}
