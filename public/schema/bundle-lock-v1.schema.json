{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ladder.dev/schema/bundle-lock-v1.schema.json",
  "title": "Ladder Graph Bundle Lockfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockVersion", "bundle", "target", "sourceHash", "assets"],
  "properties": {
    "lockVersion": { "const": 1 },
    "bundle": { "type": "string" },
    "target": { "enum": ["codex", "claude", "hermes", "python", "typescript"] },
    "sourceHash": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind", "name", "version", "sourceHash"],
        "properties": {
          "ref": { "type": "string" },
          "kind": { "enum": ["Workflow", "Ontology", "Form", "Document", "WorkflowBundle"] },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "sourceHash": { "type": "string" }
        }
      }
    }
  }
}
