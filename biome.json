{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!public/catalog/bodies",
      "!target",
      "!coverage",
      "!artifacts",
      "!test-results",
      "!.vercel",
      "!src/wasm/pkg",
      "!src/generated/catalogTestFixtures.ts",
      "!visual-sde-graph-builder",
      "!agent_templates.json",
      "!security_architecture_agent_templates.json",
      "!openrouter_multimodal_connectors.json",
      "!math_music_physics_agent_templates.json",
      "!math_music_physics_workflow_templates.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": "off",
        "noStaticElementInteractions": "off",
        "useButtonType": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["ladder-graph-help.html"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/generated/catalog.ts", "src/generated/artifactCatalog.ts"],
      "files": {
        "maxSize": 4194304
      }
    }
  ]
}
